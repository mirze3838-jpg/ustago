rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Daxil olub-olmadığını yoxlayır
    function signedIn() {
      return request.auth != null;
    }

    // Yalnız hesab sahibi
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Admin olub-olmadığını təhlükəsiz yoxlayır
    function isAdmin() {
      return signedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // İSTİFADƏÇİ VƏ USTA PROFİLLƏRİ
    match /users/{userId} {
      // Müştərilər və digər istifadəçilər ustaların profilini görə bilsin deyə read açıqdır
      allow read: if signedIn();

      // Qeydiyyat: Heç kim özünü birbaşa 'admin' edə bilməz!
      allow create: if signedIn() 
        && request.auth.uid == userId
        && request.resource.data.role in ['usta', 'worker', 'customer', 'seller']
        && request.resource.data.keys().hasAll(['fullName', 'role', 'createdAt']);

      // Redaktə: İstifadəçi öz məlumatını redaktə edə bilər, amma ROLUNU dəyişib admin edə BİLMƏZ!
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();

      // Hesabı yalnız admin və ya istifadəçi özü silə bilər
      allow delete: if isOwner(userId) || isAdmin();
    }

    // USTA ELANLARI / XİDMƏTLƏRİ
    match /listings/{listingId} {
      allow read: if true; // Hər kəs elanları axtarıb görə bilər
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ŞİKAYƏT VƏ MODERASİYA SİSTEMİ
    match /reports/{reportId} {
      allow create: if signedIn(); // İstənilən istifadəçi şikayət yaza bilər
      allow read, update, delete: if isAdmin(); // Yalnız admin oxuyub tədbir görə bilər
    }

    // SHORTS VƏ SOSİAL FUNKSİYALAR (Like, Rəylər, İzləmə, Saxlama)
    match /shorts/{shortId} {
      allow read: if true; // Hər kəs videoları izləyə bilər
      allow create: if signedIn();
      
      // Təhlükəsiz Redaktə Qaydası:
      // 1. Video sahibi və ya Admin videonun məlumatlarını dəyişə bilər
      // 2. Kənar istifadəçilər YALNIZ və YALNIZ 'likes', 'likedBy' və ya 'commentsCount' sahələrini yeniləyə bilər (videoUrl, title, userId dəyişdirilə BİLMƏZ!)
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'commentsCount'])
      );
      
      // Yalnız video sahibi və ya Admin silə bilər
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Şərhlər alt-kolleksiyası
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        // Şərhin yalnız 'likes' sayğacı yenilənə bilər və ya şərh müəllifi redaktə edə bilər
        allow update: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        );
        // Yalnız şərh sahibi, videonun sahibi və ya Admin silə bilər
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/shorts/$(shortId)).data.userId == request.auth.uid ||
          isAdmin()
        );

        // Şərh bəyənmələri (Yalnız öz UID-si ilə)
        match /likes/{userId} {
          allow read: if true;
          allow write: if signedIn() && request.auth.uid == userId;
        }
      }

      // Video bəyənmələri alt-kolleksiyası (Yalnız öz UID-si ilə)
      match /likes/{userId} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == userId;
      }
    }

    // İZLƏMƏ SİSTEMİ (FOLLOWERS / FOLLOWING)
    match /users/{userId}/followers/{followerId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == followerId;
    }

    match /users/{userId}/following/{targetUserId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // SEÇİLMİŞ VİDEOLAR (SAVED SHORTS)
    match /users/{userId}/saved_shorts/{shortId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}