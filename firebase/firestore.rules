rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Daxil olub-olmadığını yoxlayır
    function signedIn() {
      return request.auth != null;
    }

    // Yalnız hesab sahibi
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Admin olub-olmadığını təhlükəsiz yoxlayır
    function isAdmin() {
      return signedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // İSTİFADƏÇİ VƏ USTA PROFİLLƏRİ
    match /users/{userId} {
      // Müştərilər və digər istifadəçilər ustaların profilini görə bilsin deyə read açıqdır
      allow read: if signedIn();

      // Qeydiyyat: Heç kim özünü birbaşa 'admin' edə bilməz!
      allow create: if signedIn() 
        && request.auth.uid == userId
        && request.resource.data.role in ['usta', 'worker', 'customer', 'seller']
        && request.resource.data.keys().hasAll(['fullName', 'role', 'createdAt']);

      // Redaktə Təhlükəsizliyi:
      // 1. İstifadəçi öz məlumatını redaktə edərkən ROLUNU dəyişə BİLMƏZ!
      // 2. Sayğaclar (followersCount, followingCount) istifadəçi tərəfindən istədiyi rəqəmə dəyişdirilə bilməz, yalnız +-1 artırıla/azaldıla bilər!
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        (!('followingCount' in request.resource.data) || !('followingCount' in resource.data) ||
          request.resource.data.followingCount == resource.data.followingCount + 1 ||
          request.resource.data.followingCount == resource.data.followingCount - 1 ||
          request.resource.data.followingCount == resource.data.followingCount)
      );

      // Hesabı yalnız admin və ya istifadəçi özü silə bilər
      allow delete: if isOwner(userId) || isAdmin();
    }

    // USTA ELANLARI / XİDMƏTLƏRİ
    match /listings/{listingId} {
      allow read: if true; // Hər kəs elanları axtarıb görə bilər
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ŞİKAYƏT VƏ MODERASİYA SİSTEMİ
    match /reports/{reportId} {
      allow create: if signedIn(); // İstənilən istifadəçi şikayət yaza bilər
      allow read, update, delete: if isAdmin(); // Yalnız admin oxuyub tədbir görə bilər
    }

    // SHORTS VƏ SOSİAL FUNKSİYALAR (Like, Rəylər, İzləmə, Saxlama)
    match /shorts/{shortId} {
      allow read: if true; // Hər kəs videoları izləyə bilər
      
      // Video yaratmaq: YALNIZ öz userId-si ilə və lazımi sahələrlə
      allow create: if signedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() > 5;
      
      // Təhlükəsiz Redaktə Qaydası:
      // 1. Video sahibi və ya Admin videonun əsas məlumatlarını dəyişə bilər
      // 2. Kənar istifadəçilər yalnız 'likes' və ya 'likedBy' və ya 'commentsCount' sahələrini dəyişə bilər.
      // DƏQİQ MƏHDUDİYYƏT:
      // - 'likes' sayğacı yalnız +-1 dəyişdirilə bilər (100000 edilə BİLMƏZ!)
      // - 'likedBy' massivinə yalnız cari istifadəçinin öz auth.uid-si əlavə və ya silinə bilər (saxta UID yazıla BİLMƏZ!)
      // - 'commentsCount' yalnız +-1 dəyişdirilə bilər!
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'commentsCount']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes']) ||
            request.resource.data.likes == resource.data.likes + 1 ||
            request.resource.data.likes == resource.data.likes - 1) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentsCount']) ||
            request.resource.data.commentsCount == resource.data.commentsCount + 1 ||
            request.resource.data.commentsCount == resource.data.commentsCount - 1) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likedBy']) ||
            request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).hasOnly([request.auth.uid]) ||
            resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([request.auth.uid]))
        )
      );
      
      // Yalnız video sahibi və ya Admin silə bilər
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Şərhlər alt-kolleksiyası
      match /comments/{commentId} {
        allow read: if true;
        // Yalnız öz userId-si ilə şərh yarada bilər
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        
        // Şərhin redaktəsi: Müəllif mətnini dəyişə bilər (userId dəyişdirilə bilməz),
        // Kənar şəxslər isə yalnız 'likes' sayğacını +-1 dəyişə bilər!
        allow update: if signedIn() && (
          (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
            (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1)
          )
        );
        
        // Yalnız şərh sahibi, videonun sahibi və ya Admin silə bilər
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/shorts/$(shortId)).data.userId == request.auth.uid ||
          isAdmin()
        );

        // Şərh bəyənmələri (Yalnız öz UID-si ilə)
        match /likes/{userId} {
          allow read: if true;
          allow write: if signedIn() && request.auth.uid == userId;
        }
      }

      // Video bəyənmələri alt-kolleksiyası (Yalnız öz UID-si ilə)
      match /likes/{userId} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == userId;
      }
    }

    // İZLƏMƏ SİSTEMİ (FOLLOWERS / FOLLOWING)
    match /users/{userId}/followers/{followerId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == followerId;
    }

    match /users/{userId}/following/{targetUserId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // SEÇİLMİŞ VİDEOLAR (SAVED SHORTS)
    match /users/{userId}/saved_shorts/{shortId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}