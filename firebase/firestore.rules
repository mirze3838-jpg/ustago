rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Daxil olub-olmadığını yoxlayır
    function signedIn() {
      return request.auth != null;
    }

    // Yalnız hesab sahibi
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Admin olub-olmadığını təhlükəsiz yoxlayır
    function isAdmin() {
      return signedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // İSTİFADƏÇİ VƏ USTA PROFİLLƏRİ
    match /users/{userId} {
      // Müştərilər və qonaqlar ustaların profilini görə bilsin deyə oxuma açıqdır
      allow read: if true;

      // Qeydiyyat: Heç kim özünü birbaşa 'admin', 'isVerified: true' və ya balanslı edə bilməz!
      allow create: if signedIn() 
        && request.auth.uid == userId
        && request.resource.data.role in ['usta', 'worker', 'customer', 'seller']
        && request.resource.data.keys().hasAll(['fullName', 'role', 'createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
        && (!('balance' in request.resource.data) || request.resource.data.balance == 0)
        && (!('vipUntil' in request.resource.data))
        && (!('followersCount' in request.resource.data) || request.resource.data.followersCount == 0);

      // Redaktə Təhlükəsizliyi:
      // 1. İstifadəçi rolunu, isVerified, balance, vipUntil, rating, followersCount və isBanned sahələrini dəyişə BİLMƏZ!
      // 2. followingCount yalnız +-1 artırıla/azaldıla bilər.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'phone', 'category', 'specialtyIds', 'specialties',
          'specialtyCategories', 'pendingSpecialtyIds', 'country', 'city',
          'cityName', 'district', 'settlement', 'street',
          'gpsPermissionGranted', 'locationSharingConsent',
          'latitude', 'longitude', 'lat', 'lng', 'roleNote',
          'photoBase64', 'photoUrl', 'bio', 'socialLinks',
          'tiktokHandle', 'tiktokConnected', 'isAvailable',
          'followingCount', 'updatedAt', 'notificationsRead'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['followingCount']) ||
          (resource.data.followingCount is int && (
            request.resource.data.followingCount == resource.data.followingCount + 1 ||
            request.resource.data.followingCount == resource.data.followingCount - 1
          )) ||
          (!('followingCount' in resource.data) && request.resource.data.followingCount in [0, 1]))
      );

      // Rəylər alt-kolleksiyası: Giriş etmiş müştəri öz adından yaza bilər (özünə rəy yaza bilməz)
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid != userId
          && request.resource.data.reviewerId == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow update, delete: if signedIn() && (resource.data.reviewerId == request.auth.uid || isAdmin());
      }

      // Yazdığı rəylər alt-kolleksiyası (Yalnız hesab sahibi və ya admin)
      match /given_reviews/{reviewId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Ödəniş əməliyyatları alt-kolleksiyası (Yalnız hesab sahibi və ya admin)
      match /transactions/{txId} {
        allow read, create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // Hesabı yalnız admin və ya istifadəçi özü silə bilər
      allow delete: if isOwner(userId) || isAdmin();
    }

    // USTA PORTFOLİO POSTLARI
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ŞƏHƏR, KATEQORİYA VƏ XÜSUSİ İXTİSASLAR
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /custom_specialties/{specId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // USTA ELANLARI / XİDMƏTLƏRİ
    match /listings/{listingId} {
      allow read: if true; // Hər kəs elanları axtarıb görə bilər
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (
        isAdmin() ||
        (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId)
      );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // BAZAR MAĞAZALARI VƏ MƏHSUL ELANLARI
    match /market_stores/{docId} {
      allow read: if true;
      allow create: if signedIn()
        && (request.resource.data.ownerId == request.auth.uid || request.resource.data.userId == request.auth.uid)
        && (!('isVip' in request.resource.data) || request.resource.data.isVip == false);
      allow update: if signedIn() && (
        isAdmin() ||
        ((resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'userId', 'isVip', 'vipUntil'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
          request.resource.data.views is int &&
          (!('views' in resource.data) && request.resource.data.views == 1 ||
            resource.data.views is int && request.resource.data.views == resource.data.views + 1)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']) &&
          request.resource.data.likesCount is int &&
          request.resource.data.likesCount >= 0 &&
          (!('likesCount' in resource.data) && request.resource.data.likesCount == 1 ||
            resource.data.likesCount is int && (
              request.resource.data.likesCount == resource.data.likesCount + 1 ||
              request.resource.data.likesCount == resource.data.likesCount - 1
            ))) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount'])
      );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());

      // Elan bəyənmələri alt-kolleksiyası
      match /likes/{userId} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == userId;
      }

      // Mağaza rəyləri alt-kolleksiyası (Mağaza sahibi silə bilməz, yalnız cavab yaza bilər)
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid != get(/databases/$(database)/documents/market_stores/$(docId)).data.ownerId
          && request.auth.uid != get(/databases/$(database)/documents/market_stores/$(docId)).data.userId
          && request.resource.data.reviewerId == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow update: if signedIn() && (
          resource.data.reviewerId == request.auth.uid ||
          isAdmin() ||
          (
            (get(/databases/$(database)/documents/market_stores/$(docId)).data.ownerId == request.auth.uid ||
             get(/databases/$(database)/documents/market_stores/$(docId)).data.userId == request.auth.uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerReply', 'repliedAt'])
          )
        );
        allow delete: if signedIn() && (resource.data.reviewerId == request.auth.uid || isAdmin());
      }
    }

    // ŞİKAYƏT VƏ MODERASİYA SİSTEMİ
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin(); // Yalnız admin oxuyub tədbir görə bilər
    }

    // SHORTS VƏ SOSİAL FUNKSİYALAR (Like, Rəylər, İzləmə, Saxlama)
    match /shorts/{shortId} {
      allow read: if true; // Hər kəs videoları izləyə bilər
      
      // Video yaratmaq: YALNIZ öz userId-si ilə və lazımi sahələrlə
      allow create: if signedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() > 5;
      
      // Təhlükəsiz Redaktə Qaydası:
      // 1. Video sahibi və ya Admin videonun əsas məlumatlarını dəyişə bilər
      // 2. Kənar istifadəçilər yalnız 'likes' və ya 'likedBy' və ya 'commentsCount' sahələrini dəyişə bilər.
      // DƏQİQ MƏHDUDİYYƏT:
      // - 'likes' sayğacı yalnız +-1 dəyişdirilə bilər (100000 edilə BİLMƏZ!)
      // - 'likedBy' massivinə yalnız cari istifadəçinin öz auth.uid-si əlavə və ya silinə bilər (saxta UID yazıla BİLMƏZ!)
      // - 'commentsCount' yalnız +-1 dəyişdirilə bilər!
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'commentsCount']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes']) ||
            request.resource.data.likes == resource.data.likes + 1 ||
            request.resource.data.likes == resource.data.likes - 1) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentsCount']) ||
            request.resource.data.commentsCount == resource.data.commentsCount + 1 ||
            request.resource.data.commentsCount == resource.data.commentsCount - 1) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likedBy']) ||
            (
              request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
              request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).hasOnly([request.auth.uid]) &&
              resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).size() == 0
            ) ||
            (
              request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
              resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([request.auth.uid]) &&
              request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).size() == 0
            ))
        )
      );
      
      // Yalnız video sahibi və ya Admin silə bilər
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Şərhlər alt-kolleksiyası
      match /comments/{commentId} {
        allow read: if true;
        // Yalnız öz userId-si ilə şərh yarada bilər
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        
        // Şərhin redaktəsi: Müəllif mətnini dəyişə bilər (userId dəyişdirilə bilməz),
        // Kənar şəxslər isə yalnız 'likes' sayğacını +-1 dəyişə bilər!
        allow update: if signedIn() && (
          (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
            (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1)
          )
        );
        
        // Yalnız şərh sahibi, videonun sahibi və ya Admin silə bilər
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/shorts/$(shortId)).data.userId == request.auth.uid ||
          isAdmin()
        );

        // Şərh bəyənmələri (Yalnız öz UID-si ilə)
        match /likes/{userId} {
          allow read: if true;
          allow write: if signedIn() && request.auth.uid == userId;
        }
      }

      // Video bəyənmələri alt-kolleksiyası (Yalnız öz UID-si ilə)
      match /likes/{userId} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == userId;
      }
    }

    // İZLƏMƏ SİSTEMİ (FOLLOWERS / FOLLOWING)
    match /users/{userId}/followers/{followerId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == followerId;
    }

    match /users/{userId}/following/{targetUserId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // SEÇİLMİŞ VİDEOLAR (SAVED SHORTS)
    match /users/{userId}/saved_shorts/{shortId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}